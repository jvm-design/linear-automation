# Linear API Configuration
LINEAR_API_KEY=your_linear_api_key_here

# Team IDs (get these from Linear team settings or API)
PRODUCT_DESIGN_TEAM_ID=your_product_design_team_id
DEV_TEAM_ID=your_dev_team_id

# Auto-Estimation: Teams où l'auto-estimation est activée
# Par défaut: DEV_TEAM_ID seulement
# Pour plusieurs équipes, séparer par des virgules: team_id_1,team_id_2
AUTO_ESTIMATE_TEAM_IDS=your_dev_team_id

# Server Configuration
PORT=3000

# GitHub Token for reading tns-web deployments (Classic token with repo scope)
TNS_WEB_TOKEN=your_github_classic_token_here

# Anthropic API Key for Claude summaries and estimation refinement
# Si non configuré, l'estimation utilise uniquement les règles basées sur les données historiques
ANTHROPIC_API_KEY=your_anthropic_api_key_here